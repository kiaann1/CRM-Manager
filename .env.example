# Frontend (copy to .env in project root)
# Leave empty in dev so Vite proxies /api to the API server (recommended).
VITE_API_URL=

# API server (copy to server/.env)
# Local Docker: postgresql://crm:crm@localhost:5432/crm_manager
# Free cloud (Neon / Supabase): paste connection string + ?sslmode=require if missing
# Example Neon: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_manager
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REFRESH_SECRET=change-me-another-long-random-string-at-least-32-chars
COOKIE_SECURE=false

# Google SSO (optional) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID / Azure AD (optional)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Generic OIDC (Okta, Auth0, Keycloak, etc.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
